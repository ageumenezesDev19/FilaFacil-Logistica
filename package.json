{
  "name": "filafacil-logistica",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local terminal application for managing package collection requests",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:setup": "node scripts/prepare-database.js && prisma generate && prisma migrate deploy",
    "start": "node --import tsx src/index.js",
    "test": "node --import tsx --test tests/*.test.js"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "prisma": "7.10.0",
    "tsx": "4.23.15"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
}
